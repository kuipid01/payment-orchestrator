# Copy to .env.docker, replace the placeholders, then restrict permissions:
# chmod 600 .env.docker
#
# Generate independent random values:
# openssl rand -hex 32

DATABASE_NAME=payconnect
DATABASE_USER=payconnect
DATABASE_PASSWORD=replace-with-a-random-64-character-hex-secret

JWT_SECRET=replace-with-a-separate-random-64-character-hex-secret
ENCRYPTION_KEY=replace-with-another-random-64-character-hex-secret

API_PORT=8080
API_BASE_URL=https://api.payconnect.com
WEBHOOK_BASE_URL=https://api.payconnect.com
FRONTEND_URL=https://app.payconnect.com
ALLOWED_ORIGINS=https://payconnect.com,https://www.payconnect.com,https://app.payconnect.com

# Optional integrations
GOOGLE_CLIENT_ID=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PayConnect

# Set to the trusted reverse proxy IP/CIDR when deploying behind one.
TRUSTED_PROXIES=
